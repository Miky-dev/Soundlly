<!DOCTYPE html>
<html lang="it">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Soundlly Admin Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="/css/styleHome.css" />
    <link rel="stylesheet" href="/css/admin.css" />
    <!-- icona che appare nella linguetta del browser -->
    <link rel="icon" href="immagini/icona.png" type="image/png">
</head>

<body data-user-id="<%= typeof user !== 'undefined' && user ? user.id : 'guest' %>">
    <nav class="navbar navbar-dark bg-transparent mb-4">
        <div class="container-fluid">
            <a class="navbar-brand" href="/home">
                Admin Panel
            </a>
            <a href="/home" class="btn btn-outline-light btn-sm">Torna alla Home</a>
        </div>
    </nav>

    <div class="admin-container">
        <h1>Dashboard Amministrazione</h1>
        <p class="lead">Gestisci i contenuti della piattaforma.</p>

        <!-- Barra di ricerca -->
        <div class="mb-4">
            <input type="text" id="adminSearch" class="form-control form-control-lg bg-dark text-white border-secondary"
                placeholder="Cerca per nome o autore...">
        </div>

        <ul class="nav nav-pills mb-4" id="adminTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="ambient-tab" data-bs-toggle="pill" data-bs-target="#ambient"
                    type="button" role="tab">Suoni Sistema</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="usersounds-tab" data-bs-toggle="pill" data-bs-target="#usersounds"
                    type="button" role="tab">Suoni Utenti</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="usersongs-tab" data-bs-toggle="pill" data-bs-target="#usersongs"
                    type="button" role="tab">Canzoni Utenti</button>
            </li>
        </ul>

        <div class="tab-content" id="adminTabsContent">

            <!-- TAB: Suoni di Sistema (Ambient) -->
            <div class="tab-pane fade show active" id="ambient" role="tabpanel">
                <div class="admin-card">
                    <h3>Aggiungi Suono Ambientale</h3>
                    <form id="addSoundForm" class="row g-3 align-items-end">
                        <div class="col-md-3">
                            <label class="form-label">Nome</label>
                            <input type="text" class="form-control" name="title" placeholder="Es. Pioggia" required>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Icona (FontAwesome)</label>
                            <input type="text" class="form-control" name="icon" placeholder="Es. fa-cloud-rain"
                                required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">File Audio (MP3)</label>
                            <input type="file" class="form-control" name="audioFile" accept="audio/*" required>
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-success w-100">Aggiungi</button>
                        </div>
                    </form>
                </div>

                <div class="admin-card">
                    <h3>Suoni Sistema</h3>
                    <table class="table table-dark-transparent align-middle">
                        <thead>
                            <tr>
                                <th class="bulk-check-col"></th>
                                <th>Icona</th>
                                <th>Nome</th>
                                <th>File</th>
                                <th>Azioni</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% systemSounds.forEach(sound=> { %>
                                <tr>
                                    <td class="text-center">
                                        <input type="checkbox" class="select-item" value="<%= sound.id %>">
                                    </td>
                                    <td><i class="fa-solid <%= sound.icon %> fa-lg"></i></td>
                                    <td>
                                        <span class="view-mode">
                                            <%= sound.title %>
                                        </span>
                                        <input type="text" class="form-control edit-mode d-none form-control-sm"
                                            value="<%= sound.title %>">
                                    </td>
                                    <td>
                                        <%= sound.filename %>
                                    </td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-warning btn-edit"
                                            data-id="<%= sound.id %>"><i class="fa-solid fa-pen"></i></button>
                                        <button class="btn btn-sm btn-success btn-save d-none"
                                            data-id="<%= sound.id %>"><i class="fa-solid fa-check"></i></button>
                                        <button class="btn btn-sm btn-outline-danger btn-delete"
                                            data-id="<%= sound.id %>"><i class="fa-solid fa-trash"></i></button>
                                    </td>
                                </tr>
                                <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- TAB: Suoni caricati dagli Utenti (Ambient) -->
            <div class="tab-pane fade" id="usersounds" role="tabpanel">
                <div class="admin-card">
                    <h3>Suoni Caricati dagli Utenti</h3>
                    <table class="table table-dark-transparent align-middle">
                        <thead>
                            <tr>
                                <th class="bulk-check-col"></th>
                                <th>Icona</th>
                                <th>Nome</th>
                                <th>Utente</th>
                                <th>File</th>
                                <th>Azioni</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% userAmbientSounds.forEach(sound=> { %>
                                <tr>
                                    <td class="text-center">
                                        <input type="checkbox" class="select-item" value="<%= sound.id %>">
                                    </td>
                                    <td><i class="fa-solid <%= sound.icon %> fa-lg"></i></td>
                                    <td>
                                        <%= sound.title %>
                                    </td>
                                    <td><span class="text-info">
                                            <%= sound.owner_name %>
                                        </span></td>
                                    <td>
                                        <%= sound.filename %>
                                    </td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-danger btn-delete"
                                            data-id="<%= sound.id %>"><i class="fa-solid fa-trash"></i></button>
                                    </td>
                                </tr>
                                <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- TAB: Canzoni caricate dagli Utenti (Musica) -->
            <div class="tab-pane fade" id="usersongs" role="tabpanel">
                <div class="admin-card">
                    <h3>Canzoni Caricate dagli Utenti</h3>
                    <table class="table table-dark-transparent align-middle">
                        <thead>
                            <tr>
                                <th class="bulk-check-col"></th>
                                <th>Titolo</th>
                                <th>Utente</th>
                                <th>File</th>
                                <th>Azioni</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% userSongs.forEach(sound=> { %>
                                <tr>
                                    <td class="text-center">
                                        <input type="checkbox" class="select-item" value="<%= sound.id %>">
                                    </td>
                                    <td>
                                        <% if (sound.icon && sound.icon.startsWith('/')) { %>
                                            <img src="<%= sound.icon %>" alt="cover"
                                                style="width: 30px; height: 30px; border-radius: 4px; object-fit: cover;">
                                            <% } else { %>
                                                <i class="fa-solid fa-music fa-lg"></i>
                                                <% } %>
                                                    <span class="ms-2">
                                                        <%= sound.title %>
                                                    </span>
                                    </td>
                                    <td><span class="text-info">
                                            <%= sound.owner_name %>
                                        </span></td>
                                    <td>
                                        <%= sound.filename %>
                                    </td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-danger btn-delete"
                                            data-id="<%= sound.id %>"><i class="fa-solid fa-trash"></i></button>
                                    </td>
                                </tr>
                                <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/background-timer.js"></script>
    <!-- Modale di conferma personalizzata -->
    <div id="deleteModal" class="delete-modal-overlay hidden">
        <div class="delete-modal">
            <h3>Conferma Eliminazione</h3>
            <p id="deleteModalText">Sei sicuro di voler eliminare questo elemento?</p>
            <div class="modal-actions">
                <button id="cancelDelete" class="btn btn-secondary">Annulla</button>
                <button id="confirmDelete" class="btn btn-danger">Elimina</button>
            </div>
        </div>
    </div>

    <!-- Barra per azioni di gruppo (Bulk Actions) -->
    <div id="bulkActionsBar" class="bulk-actions-bar">
        <span class="bulk-info"><span id="selectedCount">0</span> selezionati</span>
        <button id="bulkDeleteBtn" class="btn-bulk-delete">
            <i class="fa-solid fa-trash"></i> Elimina
        </button>
    </div>

    <script src="/js/admin.js"></script>
</body>

</html>