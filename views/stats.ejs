<!DOCTYPE html>
<html lang="it">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Le Tue Statistiche - Soundlly</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/css/bootstrap.min.css" rel="stylesheet"
        crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="/css/styleHome.css">
    <link rel="icon" href="/immagini/logo3.png" type="image/png">
    <link rel="stylesheet" href="/css/stats.css">
    <style>
        .chart-wrapper {
            height: 300px;
            width: 100%;
        }

        /* Override generic progress bar widths */
        .w-0 {
            width: 0%;
        }
    </style>
</head>

<body>

    <!-- Simple Navbar -->
    <!-- Simple Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-transaparent">
        <div class="container-fluid">
            <a href="/home" class="text-decoration-none">
                <span class="app-logo">soundlly</span>
            </a>
            <a href="/home" class="btn btn-outline-light btn-sm"><i class="fa-solid fa-arrow-left"></i> Torna alla
                Home</a>
        </div>
    </nav>

    <% function formatTime(minutes) { if (minutes < 60) return minutes + " min" ; const h=Math.floor(minutes / 60);
        const m=minutes % 60; return h + "h " + (m> 0 ? m + "m" : "");
        }
        %>
        <div class="stats-container">
            <h1 class="mb-5">Le Tue Statistiche</h1>


            <!-- Hidden Data for Chart & Progress -->
            <input type="hidden" id="chartDataInput"
                value="<%= encodeURIComponent(JSON.stringify(chart || { labels: [], data: [] })) %>">
            <input type="hidden" id="progressDataInput" value="<%= encodeURIComponent(JSON.stringify({
                today: Math.min((progress.today / userGoals.daily_focus_goal) * 100, 100),
                week: Math.min((progress.week / userGoals.weekly_focus_goal) * 100, 100),
                month: Math.min((progress.month / userGoals.monthly_focus_goal) * 100, 100)
            })) %>">

            <!-- Goals Section -->
            <div class="row mb-5">
                <div class="col-12">
                    <div class="stat-card-box stat-card-box-aligned">
                        <div class="section-header d-flex justify-content-between align-items-center">
                            <h2><i class="fa-solid fa-bullseye"></i> Obiettivi & Progressi</h2>
                            <button class="btn btn-outline-light btn-sm" data-bs-toggle="modal"
                                data-bs-target="#goalsModal">
                                <i class="fa-solid fa-pen"></i> Modifica
                            </button>
                        </div>

                        <div class="row mt-4 g-4">
                            <!-- Daily -->
                            <div class="col-md-4">
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-white">Giornaliero</span>
                                    <span class="text-teal">
                                        <%= formatTime(progress.today) %> / <%= formatTime(userGoals.daily_focus_goal)
                                                %>
                                    </span>
                                </div>
                                <div class="progress progress-bg">
                                    <div class="progress-bar progress-bar-teal w-0" id="prog-today" role="progressbar">
                                    </div>
                                </div>
                            </div>

                            <!-- Weekly -->
                            <div class="col-md-4">
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-white">Settimanale</span>
                                    <span class="text-teal">
                                        <%= formatTime(progress.week) %> / <%= formatTime(userGoals.weekly_focus_goal)
                                                %>
                                    </span>
                                </div>
                                <div class="progress progress-bg">
                                    <div class="progress-bar progress-bar-teal w-0" id="prog-week" role="progressbar">
                                    </div>
                                </div>
                            </div>

                            <!-- Monthly -->
                            <div class="col-md-4">
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-white">Mensile</span>
                                    <span class="text-teal">
                                        <%= formatTime(progress.month) %> / <%= formatTime(userGoals.monthly_focus_goal)
                                                %>
                                    </span>
                                </div>
                                <div class="progress progress-bg">
                                    <div class="progress-bar progress-bar-teal w-0" id="prog-month" role="progressbar">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Goals Modal -->
            <div class="modal fade" id="goalsModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content modal-content-dark">
                        <div class="modal-header border-bottom-0">
                            <h5 class="modal-title">Modifica Obiettivi</h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                                aria-label="Close"></button>
                        </div>
                        <form action="/stats/goals" method="POST">
                            <div class="modal-body">
                                <!-- Daily -->
                                <div class="mb-3">
                                    <label class="form-label text-white">Obiettivo Giornaliero</label>
                                    <div class="row g-2">
                                        <div class="col-6">
                                            <div class="input-group">
                                                <input type="number" name="daily_hours"
                                                    class="form-control bg-dark text-white border-secondary"
                                                    placeholder="Ore" min="0"
                                                    value="<%= Math.floor(userGoals.daily_focus_goal / 60) %>">
                                                <span
                                                    class="input-group-text bg-dark text-white border-secondary">ore</span>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="input-group">
                                                <input type="number" name="daily_minutes"
                                                    class="form-control bg-dark text-white border-secondary"
                                                    placeholder="Min" min="0" max="59"
                                                    value="<%= userGoals.daily_focus_goal % 60 %>">
                                                <span
                                                    class="input-group-text bg-dark text-white border-secondary">min</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Weekly -->
                                <div class="mb-3">
                                    <label class="form-label text-white">Obiettivo Settimanale</label>
                                    <div class="row g-2">
                                        <div class="col-6">
                                            <div class="input-group">
                                                <input type="number" name="weekly_hours"
                                                    class="form-control bg-dark text-white border-secondary"
                                                    placeholder="Ore" min="0"
                                                    value="<%= Math.floor(userGoals.weekly_focus_goal / 60) %>">
                                                <span
                                                    class="input-group-text bg-dark text-white border-secondary">ore</span>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="input-group">
                                                <input type="number" name="weekly_minutes"
                                                    class="form-control bg-dark text-white border-secondary"
                                                    placeholder="Min" min="0" max="59"
                                                    value="<%= userGoals.weekly_focus_goal % 60 %>">
                                                <span
                                                    class="input-group-text bg-dark text-white border-secondary">min</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Monthly -->
                                <div class="mb-3">
                                    <label class="form-label text-white">Obiettivo Mensile</label>
                                    <div class="row g-2">
                                        <div class="col-6">
                                            <div class="input-group">
                                                <input type="number" name="monthly_hours"
                                                    class="form-control bg-dark text-white border-secondary"
                                                    placeholder="Ore" min="0"
                                                    value="<%= Math.floor(userGoals.monthly_focus_goal / 60) %>">
                                                <span
                                                    class="input-group-text bg-dark text-white border-secondary">ore</span>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="input-group">
                                                <input type="number" name="monthly_minutes"
                                                    class="form-control bg-dark text-white border-secondary"
                                                    placeholder="Min" min="0" max="59"
                                                    value="<%= userGoals.monthly_focus_goal % 60 %>">
                                                <span
                                                    class="input-group-text bg-dark text-white border-secondary">min</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="modal-footer border-top-0">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annulla</button>
                                <button type="submit" class="btn btn-primary btn-primary-teal">Salva</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Overview Cards -->
            <div class="row g-4 mb-5">
                <div class="col-md-3">
                    <div class="stat-card-box">
                        <i class="fa-solid fa-clock fa-2x text-white-50"></i>
                        <div class="stat-value">
                            <%= totalFocusMinutes %>
                        </div>
                        <div class="stat-label">Minuti Focus</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-card-box">
                        <i class="fa-solid fa-bullseye fa-2x text-white-50"></i>
                        <div class="stat-value">
                            <%= completedSessions %>
                        </div>
                        <div class="stat-label">Sessioni Completate</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-card-box">
                        <i class="fa-solid fa-check-circle fa-2x text-white-50"></i>
                        <div class="stat-value">
                            <%= completedTodos %>
                        </div>
                        <div class="stat-label">Task Completati</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-card-box">
                        <i class="fa-solid fa-list-ul fa-2x text-white-50"></i>
                        <div class="stat-value">
                            <%= pendingTodos %>
                        </div>
                        <div class="stat-label">Task Pendenti</div>
                    </div>
                </div>
            </div>

            <!-- Weekly Chart Section -->
            <div class="row mb-5">
                <div class="col-12">
                    <div class="stat-card-box stat-card-box-aligned">
                        <div class="section-header">
                            <h2><i class="fa-solid fa-chart-line"></i> Andamento Settimanale</h2>
                        </div>
                        <div class="chart-wrapper">
                            <canvas id="weeklyChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Detailed Tables -->
            <div class="row g-4">
                <!-- Top Ambient Sounds -->
                <div class="col-lg-6">
                    <div class="stat-card-box stat-card-box-aligned">
                        <div class="section-header">
                            <h2><i class="fa-solid fa-headphones"></i> Suoni Più Ascoltati</h2>
                        </div>
                        <% if (topSounds.length> 0) { %>
                            <table class="table-custom">
                                <thead>
                                    <tr>
                                        <th>Suono</th>
                                        <th>Tempo Totale (min)</th>
                                        <th>Ultimo Ascolto</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% topSounds.forEach(sound=> { %>
                                        <tr>
                                            <td>
                                                <%= sound.title || sound.sound_id %>
                                            </td>
                                            <td>
                                                <%= (sound.total_seconds / 60).toFixed(1) %>
                                            </td>
                                            <td>
                                                <%= new Date(sound.last_listened_at).toLocaleDateString() %>
                                            </td>
                                        </tr>
                                        <% }); %>
                                </tbody>
                            </table>
                            <% } else { %>
                                <p class="text-white-50 text-center py-5">Nessun dato di ascolto disponibile ancora.</p>
                                <% } %>
                    </div>
                </div>

                <!-- Recent Focus Sessions -->
                <div class="col-lg-6">
                    <div class="stat-card-box stat-card-box-aligned">
                        <div class="section-header">
                            <h2><i class="fa-solid fa-history"></i> Ultime Sessioni Focus</h2>
                        </div>
                        <% if (recentSessions.length> 0) { %>
                            <table class="table-custom">
                                <thead>
                                    <tr>
                                        <th>Data</th>
                                        <th>Tipo</th>
                                        <th>Durata</th>
                                        <th>Stato</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% recentSessions.forEach(session=> { %>
                                        <tr>
                                            <td>
                                                <%= new Date(session.started_at).toLocaleDateString() %>
                                            </td>
                                            <td>
                                                <%= session.session_type %>
                                            </td>
                                            <td>
                                                <%= session.completed_minutes %> min
                                            </td>
                                            <td>
                                                <% if (session.status==='completed' ) { %>
                                                    <span class="badge bg-success">Completata</span>
                                                    <% } else { %>
                                                        <span class="badge bg-secondary">
                                                            <%= session.status %>
                                                        </span>
                                                        <% } %>
                                            </td>
                                        </tr>
                                        <% }); %>
                                </tbody>
                            </table>
                            <% } else { %>
                                <p class="text-white-50 text-center py-5">Nessuna sessione registrata di recente.</p>
                                <% } %>
                    </div>
                </div>
            </div>

        </div>

        <!-- Footer (Reused) -->
        <footer class="site-footer">
            <div class="footer-container">
                <div class="footer-bottom footer-bottom-center">
                    <p>© 2025 Soundlly. Tutti i diritti riservati.</p>
                </div>
            </div>
        </footer>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/js/bootstrap.bundle.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

        <script>
            document.addEventListener('DOMContentLoaded', () => {
                // Retrieve and parse data from hidden inputs
                const chartDataInput = document.getElementById('chartDataInput');
                const progressDataInput = document.getElementById('progressDataInput');

                let chartData = { labels: [], data: [] };
                let progressData = { today: 0, week: 0, month: 0 };

                try {
                    if (chartDataInput && chartDataInput.value) {
                        chartData = JSON.parse(decodeURIComponent(chartDataInput.value));
                    }
                    if (progressDataInput && progressDataInput.value) {
                        progressData = JSON.parse(decodeURIComponent(progressDataInput.value));
                    }
                } catch (e) {
                    console.error("Error parsing stats data", e);
                }

                // Set Progress Bars
                const setWidth = (id, val) => {
                    const el = document.getElementById(id);
                    if (el) el.style.width = val + '%';
                };
                setWidth('prog-today', progressData.today);
                setWidth('prog-week', progressData.week);
                setWidth('prog-month', progressData.month);


                // Render Chart
                const canvas = document.getElementById('weeklyChart');
                if (canvas) {
                    const ctx = canvas.getContext('2d');
                    const myChart = new Chart(ctx, {
                        type: 'line',
                        data: {
                            labels: chartData.labels,
                            datasets: [{
                                label: 'Minuti Focus',
                                data: chartData.data,
                                backgroundColor: 'rgba(42, 157, 143, 0.2)',
                                borderColor: '#2a9d8f',
                                borderWidth: 2,
                                fill: true,
                                tension: 0.4, // Smooth curve
                                pointBackgroundColor: '#2a9d8f'
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: {
                                    display: false
                                },
                                tooltip: {
                                    callbacks: {
                                        label: function (context) {
                                            return context.parsed.y + ' min';
                                        }
                                    }
                                }
                            },
                            scales: {
                                y: {
                                    beginAtZero: true,
                                    grid: {
                                        color: 'rgba(255, 255, 255, 0.1)'
                                    },
                                    ticks: {
                                        color: '#ccc'
                                    }
                                },
                                x: {
                                    grid: {
                                        display: false
                                    },
                                    ticks: {
                                        color: '#ccc'
                                    }
                                }
                            }
                        }
                    });
                }
            });
        </script>
</body>

</html>