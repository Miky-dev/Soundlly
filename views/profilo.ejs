<!DOCTYPE html>
<html lang="it">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Il tuo Profilo - Soundlly</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/css/bootstrap.min.css" rel="stylesheet"
        crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="/css/profilo.css" />
    <link rel="icon" href="immagini/logo3.png" type="image/png">

</head>

<body>

    <!-- Navbar (Reused) -->
    <!-- Simple Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-transaparent fixed-top">
        <div class="container-fluid">
            <a href="/home" style="text-decoration: none;">
                <span class="app-logo">soundlly</span>
            </a>
            <a href="/home" class="btn btn-outline-light btn-sm"><i class="fa-solid fa-arrow-left"></i> Torna alla
                Home</a>
        </div>
    </nav>

    <div class="profile-container">

        <!-- Header Profilo -->
        <header class="profile-header">
            <img src="<%= user.avatar_url || '/immagini/logo2.png' %>" alt="Avatar" class="profile-avatar"
                onerror="this.onerror=null;this.src='/immagini/logo2.png';">
            <div class="profile-info">
                <div class="profile-main">
                    <h1 class="profile-name">
                        <%= user.display_name || user.username %>
                    </h1>
                    <div class="profile-badges">
                        <span class="profile-badge <%= user.plan === 'premium' ? 'premium' : '' %>">
                            <%= user.role.toUpperCase() %> | <%= user.plan.toUpperCase() %>
                        </span>
                        <span class="profile-badge stats">
                            <i class="fa-solid fa-music"></i>
                            <%= sounds ? sounds.length : 0 %> Suoni
                        </span>
                    </div>
                </div>

                <div class="profile-meta">
                    <div class="meta-item">
                        <i class="fa-solid fa-envelope text-brand"></i>
                        <span>
                            <%= user.email %>
                        </span>
                    </div>
                    <div class="meta-item">
                        <i class="fa-solid fa-calendar-alt text-brand"></i>
                        <span>Membro dal <%= new Date(user.created_at).toLocaleDateString() %></span>
                    </div>
                </div>

                <% if (user.bio) { %>
                    <div class="profile-bio">
                        "<%= user.bio %>"
                    </div>
                    <% } %>

                        <!-- Extra Details: DoB, Born City, Country ONLY - INSIDE HEADER -->
                        <div class="profile-extra">
                            <% if (user.date_of_birth) { %>
                                <span class="extra-tag"><i class="fa-solid fa-cake-candles"></i>
                                    <%= new Date(user.date_of_birth).toLocaleDateString() %>
                                </span>
                                <% } %>

                                    <% if (user.born_city) { %>
                                        <span class="extra-tag"><i class="fa-solid fa-map-marker-alt"></i>
                                            <%= user.born_city %>
                                        </span>
                                        <% } %>

                                            <% if (user.location_country) { %>
                                                <span class="extra-tag"><i class="fa-solid fa-earth-americas"></i>
                                                    <%= user.location_country %>
                                                </span>
                                                <% } %>
                        </div>
            </div>
        </header>

        <% if (typeof error !=='undefined' && error) { %>
            <div class="alert alert-danger">Si è verificato un errore, riprova.</div>
            <% } %>
                <% if (user.plan==='premium' || user.role==='admin' || user.role==='creator' ) { %>
                    <div class="alert alert-info">
                        <i class="fa-solid fa-star"></i> Accesso Premium ATTIVO.
                    </div>
                    <% } %>

                        <!-- Modifica Profilo -->
                        <section class="section-box">
                            <h2 class="section-title"><i class="fa-solid fa-user-pen"></i> Modifica Profilo</h2>
                            <form id="profile-form" action="/profilo/update?_csrf=<%= csrfToken %>" method="POST"
                                class="form-dark" enctype="multipart/form-data">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                                <div class="row">
                                    <div class="col-md-6">
                                        <label class="form-label text-light">Username (non modificabile)</label>
                                        <input type="text" class="form-control" value="<%= user.username %>" disabled>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label text-light">Nome Visualizzato</label>
                                        <input type="text" name="display_name" class="form-control"
                                            value="<%= user.display_name || '' %>" placeholder="Il tuo nome">
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label text-light">Immagine Profilo</label>

                                    <!-- Drag & Drop Zone -->
                                    <div id="drop-zone" class="drop-zone">
                                        <div class="drop-zone-content">
                                            <i class="fa-solid fa-cloud-arrow-up fa-2x mb-2 text-muted"></i>
                                            <p class="mb-1">Trascina qui un'immagine o clicca per caricare</p>
                                            <small class="text-white-50">JPG o PNG</small>
                                        </div>
                                        <img id="avatar-preview" src="<%= user.avatar_url || '' %>"
                                            class="preview-hidden">
                                        <input type="file" name="avatar" id="avatar-input"
                                            accept="image/png, image/jpeg" hidden>
                                    </div>

                                    <!-- Fallback/Hidden URL for maintaining current if no file -->
                                    <input type="hidden" name="avatar_url" value="<%= user.avatar_url || '' %>">
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <label class="form-label text-light">Città Attuale</label>
                                        <input type="text" name="location_city" class="form-control"
                                            value="<%= user.location_city || '' %>" placeholder="Dove vivi ora">
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label text-light">Paese</label>
                                        <input type="text" name="location_country" class="form-control"
                                            value="<%= user.location_country || '' %>" placeholder="Italia">
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <label class="form-label text-light">Mood Theme</label>
                                        <select name="mood_theme" class="form-control form-select">
                                            <option value="default" <%=user.mood_theme==='default' ? 'selected' : '' %>
                                                >Default</option>
                                            <option value="dark" <%=user.mood_theme==='dark' ? 'selected' : '' %>>Dark
                                                Mode</option>
                                            <option value="light" <%=user.mood_theme==='light' ? 'selected' : '' %>
                                                >Light Mode</option>
                                            <option value="forest" <%=user.mood_theme==='forest' ? 'selected' : '' %>
                                                >Forest</option>
                                            <option value="ocean" <%=user.mood_theme==='ocean' ? 'selected' : '' %>
                                                >Ocean</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label text-light">Bio</label>
                                    <textarea name="bio" class="form-control" rows="3"
                                        placeholder="Qualcosa su di te..."><%= user.bio || '' %></textarea>
                                </div>


                                <div class="d-flex justify-content-between align-items-center mt-3">
                                    <button type="submit" class="btn-save mb-0">Salva Modifiche</button>
                                    <a href="/logout" class="btn btn-outline-danger">Logout</a>
                                </div>
                            </form>
                        </section>

                        <!-- I Miei Suoni (Solo se esistono) -->
                        <% if (sounds && sounds.length> 0) { %>
                            <section class="section-box">
                                <h2 class="section-title"><i class="fa-solid fa-music"></i> I Miei Suoni Caricati</h2>
                                <div class="sound-list">
                                    <% sounds.forEach(sound=> { %>
                                        <div class="sound-card">
                                            <div class="sound-icon">
                                                <% let iconClass=sound.icon || 'file-audio' ; if
                                                    (!iconClass.startsWith('fa-')) iconClass='fa-' + iconClass; %>
                                                    <i class="fa-solid <%= iconClass %>"></i>
                                            </div>
                                            <h5 class="text-white text-truncate">
                                                <%= sound.title %>
                                            </h5>
                                            <p class="text-white-50 small">
                                                <% let seconds=sound.total_play_seconds || 0; let timeString="" ; if
                                                    (seconds < 60) { timeString=seconds + " sec" ; } else if (seconds <
                                                    3600) { timeString=Math.floor(seconds / 60) + " min" ; } else if
                                                    (seconds < 86400) { timeString=(seconds / 3600).toFixed(1) + " ore"
                                                    ; } else { timeString=(seconds / 86400).toFixed(1) + " giorni" ; }
                                                    %>
                                                    <i class="fa-solid fa-headphones"></i>
                                                    <%= timeString %> ascoltati
                                            </p>
                                            <p class="text-white-50 small">
                                                <%= new Date(sound.created_at).toLocaleDateString() %>
                                            </p>
                                        </div>
                                        <% }); %>
                                </div>
                            </section>
                            <% } else if (user.plan==='premium' ) { %>
                                <section class="section-box">
                                    <h2 class="section-title"><i class="fa-solid fa-music"></i> I Miei Suoni</h2>
                                    <p class="text-white-50">Non hai ancora caricato nessun suono. Vai alla <a
                                            href="/home" class="text-info">Home</a> per caricare!</p>
                                </section>
                                <% } %>

    </div>

    <!-- Footer (Reused) -->
    <footer class="site-footer">
        <div class="footer-container">
            <div class="footer-column">
                <h4>Seguici</h4>
                <div class="social-icons">
                    <a href="#" aria-label="Facebook"><i class="fab fa-facebook"></i></a>
                    <a href="#" aria-label="Twitter"><i class="fab fa-twitter"></i></a>
                    <a href="#" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
                </div>
            </div>
            <div class="footer-bottom">
                <p>© 2025 Soundlly. Tutti i diritti riservati.</p>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/profile-upload.js"></script>
</body>

</html>