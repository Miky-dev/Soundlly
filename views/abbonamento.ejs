<!DOCTYPE html>
<html lang="it">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Scegli il Tuo Piano - Soundlly</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/styleHome.css" />
    <link rel="stylesheet" href="/css/abbonamento.css" />
</head>

<body>
    <!-- Standard Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-transparent fixed-top">
        <div class="container-fluid">
            <a href="/home">
                <img src="/immagini/logo2.png" alt="Soundlly">
            </a>
            <a href="/home" class="btn btn-outline-light btn-sm"><i class="fa-solid fa-arrow-left"></i> Torna alla
                Home</a>
        </div>
    </nav>

    <div class="container">
        <div class="text-center">
            <h1 class="mt-3">Scegli il Piano Perfetto per Te</h1>
            <p class="lead">Passa a Premium per sbloccare funzionalità esclusive.</p>
        </div>

        <div class="ntx-plans">
            <div class="ntx-plan <%= (user.plan === 'standard') ? 'active' : '' %>">
                <h3>Standard</h3>
                <p class="ntx-price">€11.99</p>
                <ul>
                    <li>Pubblicazione di contenuti</li>
                    <li>2 dispositivi</li>
                    <li>Creazione playlist pubbliche</li>
                </ul>
                <% if (user.plan==='standard' ) { %>
                    <button class="ntx-btn" disabled>Piano Attuale</button>
                    <% } else { %>
                        <a href="/pagamento/standard" class="ntx-btn">Abbonati</a>
                        <button class="ntx-btn" data-plan="standard">Seleziona Standard</button>
                        <% } %>
            </div>

            <div class="ntx-plan <%= (user.plan === 'premium') ? 'active' : '' %>">
                <h3>Premium</h3>
                <p class="ntx-price">€15.99</p>
                <ul>
                    <li>Audio DOLBY ATMOS</li>
                    <li>3 dispositivi</li>
                    <li>Accesso a suoni premium</li>
                </ul>
                <% if (user.plan==='premium' ) { %>
                    <button class="ntx-btn" disabled>Piano Attuale</button>
                    <% } else { %>
                        <button class="ntx-btn" onclick="openPaymentModal('premium')">Abbonati</button>
                        <button class="ntx-btn btn-outline" onclick="fastTrack('premium')">Passa Velocemente
                            (Sim)</button>
                        <% } %>
            </div>

            <!-- Creator Plan -->
            <div class="ntx-plan <%= (user.role === 'creator') ? 'active' : '' %>">
                <h3>Creator</h3>
                <p class="ntx-price">€40.00</p>
                <ul>
                    <li>Carica i tuoi suoni</li>
                    <li>Guadagna dagli ascolti</li>
                    <li>Badge Creator</li>
                </ul>
                <% if (user.role==='creator' ) { %>
                    <button class="ntx-btn" disabled>Già Creator</button>
                    <% } else { %>
                        <button class="ntx-btn" onclick="openPaymentModal('creator')">Diventa Creator</button>
                        <button class="ntx-btn btn-outline" onclick="fastTrack('creator')">Passa Velocemente
                            (Sim)</button>
                        <% } %>
            </div>
        </div>

        <div id="feedback-message" class="mt-3 text-center"></div>

        <!-- Payment Modal -->
        <div id="payment-modal" class="payment-modal" style="display:none;">
            <div class="payment-content">
                <span class="close-btn" onclick="closePaymentModal()">&times;</span>
                <h2>Inserisci Dati Pagamento</h2>
                <div class="mb-3">
                    <input type="text" class="form-control" placeholder="Intestatario Carta">
                </div>
                <div class="mb-3">
                    <input type="text" class="form-control" placeholder="Numero Carta (0000 0000 0000 0000)">
                </div>
                <div class="row mb-3">
                    <div class="col">
                        <input type="text" class="form-control" placeholder="MM/YY">
                    </div>
                    <div class="col">
                        <input type="text" class="form-control" placeholder="CVC">
                    </div>
                </div>
                <button class="ntx-btn" onclick="processPayment()">Paga Ora</button>
            </div>
        </div>


    </div>

    <!-- Script for Logic -->
    <script>
        let selectedPlan = '';

        function openPaymentModal(plan) {
            selectedPlan = plan;
            document.getElementById('payment-modal').style.display = 'flex';
        }

        function closePaymentModal() {
            document.getElementById('payment-modal').style.display = 'none';
        }

        function fastTrack(plan) {
            fetch('/api/subscription/upgrade', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ plan: plan, method: 'fast' })
            })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        alert('Upgrade Simulato Riuscito!');
                        location.reload();
                    } else {
                        alert('Errore: ' + data.message);
                    }
                });
        }

        function processPayment() {
            // Simulate CC processing visual delay
            const payBtn = document.querySelector('#payment-modal button');
            payBtn.textContent = 'Elaborazione...';
            payBtn.disabled = true;

            fetch('/api/subscription/upgrade', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    plan: selectedPlan,
                    method: 'cc',
                    paymentDetails: { cardNumber: '1234' } // Mock data
                })
            })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        alert('Pagamento Riuscito! Benvenuto in ' + selectedPlan);
                        location.reload();
                    } else {
                        alert('Errore Pagamento: ' + data.message);
                        payBtn.textContent = 'Paga Ora';
                        payBtn.disabled = false;
                    }
                });
        }

        // Close modal if clicked outside
        window.onclick = function (event) {
            const modal = document.getElementById('payment-modal');
            if (event.target == modal) {
                modal.style.display = "none";
            }
        }
    </script>
</body>

</html>