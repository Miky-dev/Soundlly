<!DOCTYPE html>
<html lang="it">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Scegli il Tuo Piano - Soundlly</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/styleHome.css" />
    <link rel="stylesheet" href="/css/abbonamento.css" />
    <!-- icona che appare nella linguetta del browser -->
    <link rel="icon" href="immagini/icona.png" type="image/png">
</head>

<body data-user-id="<%= typeof user !== 'undefined' && user ? user.id : 'guest' %>">
    <!-- Simple Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-transparent">
        <div class="container-fluid">
            <a href="/home" class="text-decoration-none">
                <span class="app-logo">soundlly</span>
            </a>
            <a href="/home" class="btn btn-outline-light btn-sm"><i class="fa-solid fa-arrow-left"></i> Torna alla
                Home</a>
        </div>
    </nav>

    <div class="container">
        <div class="subscription-header">
            <h1>Il Piano Perfetto per Te</h1>
        </div>

        <div class="plans-container">
            <div class="plan-card <%= (user.plan === 'standard') ? 'active' : '' %>">
                <h3>Standard</h3>
                <p class="plan-price"><span style="font-family: sans-serif;">€</span>Gratis</p>
                <ul>
                    <li>Accesso catalogo base</li>
                    <li>Ascolto con pubblicità</li>
                    <li>Immersive mode</li>
                    <li>Ascolto senza pubblicità</li>
                </ul>
                <% if (user.plan==='standard' ) { %>
                    <button class="plan-btn" disabled>Piano Attuale</button>
                    <% } else { %>
                        <button class="plan-btn" data-action="subscribe" data-plan="premium">Abbonati</button>
                        <button class="plan-btn" data-action="select-plan" data-plan="standard">Seleziona
                            Standard</button>
                        <% } %>
            </div>

            <div class="plan-card <%= (user.plan === 'premium') ? 'active' : '' %>">
                <h3>Premium</h3>
                <p class="plan-price"><span style="font-family: sans-serif;">€</span>5.99</p>
                <ul>
                    <li>Privilegi dei precedenti</li>
                    <li>Audio DOLBY ATMOS</li>
                    <li>Creazione playlist pubbliche</li>
                    <li>Accesso a suoni premium</li>
                </ul>
                <% if (user.plan==='premium' ) { %>
                    <button class="plan-btn" disabled>Piano Attuale</button>
                    <% } else { %>
                        <button class="plan-btn" data-action="subscribe" data-plan="premium">Abbonati</button>
                        <button class="plan-btn btn-outline" data-action="fast-track" data-plan="premium">Seleziona
                            Premium</button>
                        <% } %>
            </div>

            <!-- Creator Plan -->
            <div class="plan-card <%= (user.role === 'creator') ? 'active' : '' %>">
                <h3>Creator</h3>
                <p class="plan-price"><span style="font-family: sans-serif;">€</span>40.00</p>
                <ul>
                    <li>Carica i tuoi suoni</li>
                    <li>Guadagna dagli ascolti</li>
                    <li>Badge Creator</li>
                </ul>
                <% if (user.role==='creator' ) { %>
                    <button class="plan-btn" disabled>Già Creator</button>
                    <% } else { %>
                        <button class="plan-btn" data-action="subscribe" data-plan="creator">Diventa Creator</button>
                        <button class="plan-btn btn-outline" data-action="fast-track" data-plan="creator">Passa
                            Velocemente
                            (Sim)</button>
                        <% } %>
            </div>
        </div>

        <div id="feedback-message" class="mt-3 text-center"></div>

        <!-- Payment Modal -->
        <div id="payment-modal" class="payment-modal">
            <div class="payment-content">
                <span class="close-btn" data-action="close-modal">&times;</span>
                <h2>Inserisci Dati Pagamento</h2>
                <div class="mb-3">
                    <input type="text" class="form-control" placeholder="Intestatario Carta">
                </div>
                <div class="mb-3">
                    <input type="text" class="form-control" placeholder="Numero Carta (0000 0000 0000 0000)">
                </div>
                <div class="row mb-3">
                    <div class="col">
                        <input type="text" class="form-control" placeholder="MM/YY">
                    </div>
                    <div class="col">
                        <input type="text" class="form-control" placeholder="CVC">
                    </div>
                </div>
                <button class="plan-btn" data-action="pay">Paga Ora</button>
            </div>
        </div>


    </div>

    <!-- Script for Logic -->
    <script src="/js/background-timer.js"></script>
    <script>
    </script>
    <script src="/js/abbonamento.js"></script>
</body>

</html>